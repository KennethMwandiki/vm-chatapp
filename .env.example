
# Frontend
VITE_AGORA_APP_ID="YOUR_AGORA_APP_ID"

# Backend Session and Authentication
SESSION_SECRET="a_long_random_string_for_session_security"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
MONGO_URI="mongodb+srv://<user>:<password>@<cluster-url>/"

# Backend API Configuration
AGORA_APP_ID="YOUR_AGORA_APP_ID"
AGORA_CUSTOMER_SECRET="YOUR_AGORA_CUSTOMER_SECRET"
BASE_URL="http://localhost:3000" # Or your Vercel URL in production

# Streaming Platforms Configuration

# 1. Meta (Facebook & Instagram)
# Requires App ID/Secret from developers.facebook.com
FACEBOOK_APP_ID="YOUR_FB_APP_ID"
FACEBOOK_APP_SECRET="YOUR_FB_APP_SECRET"
FACEBOOK_PAGE_ACCESS_TOKEN="YOUR_PAGE_ACCESS_TOKEN" # For Page streams
INSTAGRAM_USER_ACCESS_TOKEN="YOUR_IG_USER_TOKEN"    # For IG Business streams

# 2. YouTube (Google APIs)
# Requires OAuth2 Client ID/Secret or API Key with YouTube Data API v3 scope
YOUTUBE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
YOUTUBE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
YOUTUBE_REFRESH_TOKEN="YOUR_REFRESH_TOKEN"

# 3. Twitter (X)
# Requires API Key/Secret from developer.twitter.com
TWITTER_API_KEY="YOUR_API_KEY"
TWITTER_API_SECRET="YOUR_API_SECRET"
TWITTER_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"
TWITTER_ACCESS_SECRET="YOUR_ACCESS_SECRET"

# 4. LinkedIn
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_ACCESS_TOKEN="YOUR_LINKEDIN_ACCESS_TOKEN"
LINKEDIN_AUTHOR_URN="urn:li:organization:123456" # Required for API streaming
LINKEDIN_STREAM_KEY="Fallback_Stream_Key"

# 5. WeChat
WECHAT_STREAM_KEY="YOUR_WECHAT_KEY"
WECHAT_RTMP_URL="rtmp://live-push.weixin.qq.com/live"

# 6. Generic RTMP (Substack, Kick, Trovo, TikTok, DLive)
# Only Stream Key is usually required if URL is standard, or full RTMP URL
SUBSTACK_RTMP_URL="rtmp://broadcast.substack.com/live"
SUBSTACK_STREAM_KEY="YOUR_SUBSTACK_KEY"

KICK_RTMP_URL="rtmp://live.kick.com/app"
KICK_STREAM_KEY="YOUR_KICK_KEY"

TIKTOK_STREAM_KEY="YOUR_TIKTOK_KEY" # Often requires 3rd party tool or retrieval via browser logic

