{
  "name": "vm-chat-inteng-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-platform live-streaming control center.",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "test": "jest",
    "dev": "vite",
    "build:tokens": "style-dictionary build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "agora-token": "^2.0.3",
    "axios": "^1.6.8",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "5.1.0",
    "express-session": "^1.18.0",
    "mongoose": "^8.3.2",
    "passport": "0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "1.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "@vitejs/plugin-react": "5.1.0",
    "@storybook/react-vite": "8.6.14"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    }
  },
  "overrides": {
    "ts-jest": {
      "jest": "$jest"
    }
  }
}
